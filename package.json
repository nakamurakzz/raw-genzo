{
  "name": "raw-genzo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAW (RW2 etc.) を富士フイルムのフィルムシミュレーションLUTでブラウザ内現像するツール",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.ts\"",
    "deploy": "npm run build && wrangler deploy",
    "build:libraw": "scripts/build-libraw.sh"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nakamurakzz/raw-genzo.git"
  }
}
